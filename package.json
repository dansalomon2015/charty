{
  "name": "@dansalomon/charty",
  "version": "0.2.0",
  "description": "Accessible, responsive charts for financial React Native and Expo apps.",
  "keywords": [
    "react-native",
    "expo",
    "charts",
    "data-visualization",
    "finance",
    "accessibility"
  ],
  "homepage": "https://github.com/dansalomon2015/charty#readme",
  "bugs": {
    "url": "https://github.com/dansalomon2015/charty/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dansalomon2015/charty.git"
  },
  "license": "MIT",
  "author": "Dan Salomon",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "docs/images",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "clean": "bob clean",
    "lint": "tsc --noEmit",
    "prepare": "bob build",
    "prepublishOnly": "npm run verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "react-native-svg": "15.15.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/*.test.*",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "example"
  ]
}
